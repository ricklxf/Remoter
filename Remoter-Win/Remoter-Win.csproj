<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RemoterWin</AssemblyName>
    <RootNamespace>RemoterWin</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Remoter.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- DXGI Desktop Duplication for GPU-side screen capture -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.5.0" />
    <PackageReference Include="Vortice.DXGI"       Version="3.5.0" />
    <!-- Hardware H.264 encoding (NVENC/QuickSync/AMD VCE via Media Foundation,
         falls back to MF's bundled software encoder if no hardware MFT found) -->
    <PackageReference Include="Vortice.MediaFoundation" Version="3.5.0" />
    <!-- JPEG encoding via GDI+ (zero-copy from staging texture); kept as the
         fallback path when H.264 init fails -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <!-- Copy web directory to output -->
  <ItemGroup>
    <Content Include="web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- MainForm.cs loads this at runtime (window/tray icon) from
       AppContext.BaseDirectory, separately from ApplicationIcon above
       (which only sets the .exe file's own icon) -->
  <ItemGroup>
    <None Include="Remoter.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
