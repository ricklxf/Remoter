<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RemoterWin</AssemblyName>
    <RootNamespace>RemoterWin</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- DXGI Desktop Duplication for GPU-side screen capture -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.5.0" />
    <PackageReference Include="Vortice.DXGI"       Version="3.5.0" />
    <!-- JPEG encoding via GDI+ (zero-copy from staging texture) -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>
</Project>
